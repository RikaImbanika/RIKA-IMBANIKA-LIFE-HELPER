<Window x:Class="RIKA_IMBANIKA_LIFE_HELPER.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        MouseMove="Window_MouseMove"
        MouseLeftButtonUp="Window_MouseLeftButtonUp"
        SizeToContent="WidthAndHeight"
        Loaded="Window_Loaded"				 
        PreviewMouseDown="Window_PreviewMouseDown"
		ResizeMode="NoResize">

    <Grid x:Name="MainGrid" Background="Transparent">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="GlobalScale" ScaleX="1" ScaleY="1"/>
        </Grid.LayoutTransform>
        <Grid x:Name="RootGrid" Width="466" Height="450" Margin="0,-12,0,0">
            <StackPanel Margin="15,15,15,15">
                <StackPanel>
                    <StackPanel>
                        <Grid x:Name="MyGrid" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0" IsHitTestVisible="False">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="10*"/>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="10*"/>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="10*"/>
                                <RowDefinition Height="5*"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="TimerText" Text="00:00:00" FontSize="106" TextAlignment="Center" FontFamily="Segoe UI" Grid.Row="0" Margin="12,-12,12,-10">
                                <TextBlock.Foreground>
                                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                        <GradientStop Color="White" Offset="0"/>
                                        <GradientStop x:Name="SecondGradientStop" Color="Orange" Offset="1"/>
                                    </LinearGradientBrush>
                                </TextBlock.Foreground>
                            </TextBlock>
                            <TextBlock 
                                x:Name="Pause2" 
                                Text="=" 
                                FontSize="106" 
                                TextAlignment="Center" 
                                FontFamily="Segoe UI" 
                                Grid.Row="0" 
                                Margin="12,-18,12,-10"
                                RenderTransformOrigin="0.5,0.6">
                                <TextBlock.RenderTransform>
                                    <ScaleTransform ScaleX="8.5" ScaleY="1"/>
                                </TextBlock.RenderTransform>
                                <TextBlock.Foreground>
                                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                        <GradientStop Color="White" Offset="0"/>
                                        <GradientStop x:Name="Pause" Color="Orange" Offset="1"/>
                                    </LinearGradientBrush>
                                </TextBlock.Foreground>
                            </TextBlock>
                            <Grid Margin="0,-3,0,0" Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="0" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" StretchDirection="DownOnly">
                                    <TextBlock x:Name="TheM" Text="#37" FontSize="26" TextAlignment="Center" FontFamily="Segoe UI">
                                        <TextBlock.Foreground>
                                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                <GradientStop Color="White" Offset="0"/>
                                                <GradientStop Color="Black" Offset="1"/>
                                            </LinearGradientBrush>
                                        </TextBlock.Foreground>
                                    </TextBlock>
                                </Viewbox>
                                <Viewbox Grid.Column="0" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" StretchDirection="Both">
                                    <Grid Width="10" Height="3.5">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="30*"/>
                                            <RowDefinition Height="1*"/>
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="1" Width="8" Height="0.3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="125*"/>
                                                <ColumnDefinition Width="380*"/>
                                                <ColumnDefinition Width="100*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid Grid.Column="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition x:Name="ProgressFillColumn" Width="0.5*"/>
                                                    <ColumnDefinition Width="0.01*"/>
                                                    <ColumnDefinition x:Name="ProgressEmptyColumn" Width="0.5*"/>
                                                </Grid.ColumnDefinitions>

                                                <Rectangle Grid.Column="0" Fill="White" Grid.ColumnSpan="2"/>
                                                <Rectangle Grid.Column="1" Fill="Black" Grid.ColumnSpan="2"/>
                                                <Rectangle x:Name="ProgressEmptyRect" Fill="White" Grid.ColumnSpan="3" Margin="0,0,0,0" Grid.Column="2"/>
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Viewbox>
                                <Viewbox Grid.Column="1" Stretch="Uniform" StretchDirection="DownOnly">
                                    <TextBlock x:Name="SystemTimeText" FontSize="53" Text="00:00" TextAlignment="Center" Grid.Column="1" FontFamily="Segoe UI">
                                        <TextBlock.Foreground>
                                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                <GradientStop Color="White" Offset="0"/>
                                                <GradientStop Color="Red" Offset="1"/>
                                            </LinearGradientBrush>
                                        </TextBlock.Foreground>
                                    </TextBlock>
                                </Viewbox>
                                <Viewbox Grid.Column="1" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" StretchDirection="DownOnly">
                                    <TextBlock Margin="0,50,0,-19" x:Name="SpeedLabel" MaxWidth="433" TextWrapping="Wrap" Text="Video speed = x2" FontSize="11" TextAlignment="Center" FontFamily="Segoe UI">
                                        <TextBlock.Foreground>
                                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                <GradientStop Color="White" Offset="0"/>
                                                <GradientStop Color="Black" Offset="1"/>
                                            </LinearGradientBrush>
                                        </TextBlock.Foreground>
                                    </TextBlock>
                                </Viewbox>
                                <Viewbox Grid.Column="2" Stretch="Uniform"  HorizontalAlignment="Center" VerticalAlignment="Center" StretchDirection="DownOnly">
                                    <TextBlock x:Name="Rika" FontSize="20" Text="Rika Imbanika" TextAlignment="Center" FontFamily="Segoe UI">
                                        <TextBlock.Foreground>
                                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                <GradientStop Color="White" Offset="0"/>
                                                <GradientStop Color="Black" Offset="1"/>
                                            </LinearGradientBrush>
                                        </TextBlock.Foreground>
                                    </TextBlock>
                                </Viewbox>
                            </Grid>
                            <Grid Margin="0,-3,6,10" Grid.Row="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="14*"/>
                                    <ColumnDefinition Width="218*"/>
                                    <ColumnDefinition Width="69*"/>
                                    <ColumnDefinition Width="14*"/>
                                    <ColumnDefinition Width="77*"/>
                                    <ColumnDefinition Width="14*"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Row="4" Grid.ColumnSpan="6"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Stretch="Uniform"
                                     StretchDirection="DownOnly"
                                     MaxWidth="190">
                                    <TextBlock x:Name="Track"
                                       TextWrapping="Wrap"
                                       Text="Music music music"
                                       FontSize="26"
                                       TextAlignment="Center"
                                       FontFamily="Segoe UI">
                                        <TextBlock.Foreground>
                                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                <GradientStop Color="White" Offset="0"/>
                                                <GradientStop Color="Black" Offset="1"/>
                                            </LinearGradientBrush>
                                        </TextBlock.Foreground>
                                    </TextBlock>
                                </Viewbox>
                                <Viewbox Grid.Column="4" Stretch="Uniform" StretchDirection="Both">
                                    <Image Margin="12,7,12,7" x:Name="Ava1" Stretch="Uniform" Opacity="1"/>
                                </Viewbox>
                                <Viewbox Grid.Column="4" Stretch="Uniform" StretchDirection="Both">
                                    <Image Margin="12,7,12,7" x:Name="Ava2" Stretch="Uniform" Opacity="1"/>
                                </Viewbox>
                            </Grid>
                            <Grid Grid.Row="5" Height="135" Margin="12,-5,12,7">
                                <Viewbox MaxWidth="2800" StretchDirection="DownOnly" Stretch="Uniform" VerticalAlignment="Top">
                                    <TextBlock Text="33333&#xA;2&#xA;1&#xA;4" 
                                           x:Name="Quote" 
                                           TextWrapping="Wrap" 
                                           FontSize="36" 
                                           TextAlignment="Center" 
                                           FontFamily="Segoe UI">
                                        <TextBlock.Foreground>
                                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                <GradientStop Color="White" Offset="0"/>
                                                <GradientStop Color="Black" Offset="1"/>
                                            </LinearGradientBrush>
                                        </TextBlock.Foreground>
                                    </TextBlock>
                                </Viewbox>
                            </Grid>
                            <Grid.Effect>
                                <DropShadowEffect Direction="0" ShadowDepth="1" Color="Black" Opacity="100" BlurRadius="7"/>
                            </Grid.Effect>
                        </Grid>
                        <StackPanel.Effect>
                            <DropShadowEffect Direction="180" ShadowDepth="1" Color="Black" Opacity="100" BlurRadius="7" />
                        </StackPanel.Effect>
                    </StackPanel>
                    <StackPanel.Effect>
                        <DropShadowEffect Direction="90" ShadowDepth="1" Color="Black" Opacity="100" BlurRadius="7" />
                    </StackPanel.Effect>
                </StackPanel>
                <StackPanel.Effect>
                    <DropShadowEffect Direction="270" ShadowDepth="1" Color="Black" Opacity="100" BlurRadius="7" />
                </StackPanel.Effect>
            </StackPanel>
            <Grid.Effect>
                <DropShadowEffect ShadowDepth="0" Color="Black" Opacity="300" BlurRadius="40" />
            </Grid.Effect>
        </Grid>
    </Grid>
</Window>